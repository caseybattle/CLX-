# OANDA API credentials (get these from https://www.oanda.com/demo-account/tpa/personal_token
# after opening a free practice account at https://www.oanda.com/us-en/trading/)
OANDA_API_TOKEN=your-oanda-api-token
OANDA_ACCOUNT_ID=your-oanda-account-id

# "practice" or "live". Keep this on "practice" until you have tested thoroughly.
OANDA_ENVIRONMENT=practice

# Extra confirmation required before the server will accept OANDA_ENVIRONMENT=live.
# Must be set to the exact string "I_UNDERSTAND_THIS_TRADES_REAL_MONEY" to enable live trading.
LIVE_TRADING_CONFIRM=

# Shared secret that must appear in every TradingView alert payload. Generate a long random
# string (e.g. `openssl rand -hex 32`) and paste the same value into your TradingView alert JSON.
WEBHOOK_SECRET=change-me

# Hard cap on units per order, regardless of what an alert requests. Protects against a
# misconfigured strategy sending an oversized order.
MAX_ORDER_UNITS=10000
