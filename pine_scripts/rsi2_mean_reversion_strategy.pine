//@version=5
strategy("RSI-2 Mean Reversion (200SMA filter / 5SMA exit)", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=10000, initial_capital=25000,
     pyramiding=0, process_orders_on_close=true, margin_long=2, margin_short=2,
     max_labels_count=500)

// ---- Strategy inputs ----
grpStrategy = "Strategy"
rsiLength     = input.int(2, "RSI Length", group=grpStrategy)
rsiEntryLevel = input.float(10, "Enter long when RSI drops below", group=grpStrategy)
trendSmaLen   = input.int(200, "Trend filter SMA length", group=grpStrategy)
useTrendFilter = input.bool(true, "Require price above trend SMA (longs)", group=grpStrategy,
     tooltip="On: only buy dips while price holds above the trend SMA (skips washouts below it, " +
             "like a deep selloff under the 200 SMA). Off: take RSI dips in both regimes — " +
             "catches big washout lows but also catches falling knives. Backtest both.")
exitSmaLen    = input.int(5, "Exit SMA length", group=grpStrategy)
minPullbackAtr = input.float(0.0, "Min dip below recent high (ATR multiples, 0 = off)", step=0.1,
     group=grpStrategy,
     tooltip="Skips longs that fire too close to a recent high. Try 1.0: the close must be at " +
             "least 1 ATR below the highest high of the lookback window before a long is allowed. " +
             "Kills the 'buying right under the top' entries.")
pullbackLookback = input.int(20, "Recent high/low lookback (bars)", group=grpStrategy)
enableShorts  = input.bool(false, "Enable short side (mirror of long rules)", group=grpStrategy,
     tooltip="Short when RSI rises above (100 - entry level) while price is below the trend SMA; " +
             "cover when price closes back below the exit SMA. Off by default — prove out the long " +
             "side first. Keeps a single net position, so it stays compatible with OANDA US FIFO rules.")

grpRisk = "Risk (ATR stop / target)"
atrLength     = input.int(14, "ATR length", group=grpRisk)
useStopLoss   = input.bool(true, "Use ATR stop loss", group=grpRisk)
slAtrMult     = input.float(2.5, "Stop loss distance (ATR multiples)", step=0.1, group=grpRisk,
     tooltip="Mean reversion needs breathing room — a tight stop turns winners into losers. " +
             "The stop is also sent to OANDA as a real stop-loss order attached to the fill.")
useTakeProfit = input.bool(true, "Use ATR take profit", group=grpRisk)
tpAtrMult     = input.float(2.5, "Take profit distance (ATR multiples)", step=0.1, group=grpRisk,
     tooltip="Also sent to OANDA as a real take-profit order. The 5-SMA exit stays active too — " +
             "whichever is reached first closes the trade.")

grpWebhook = "Webhook"
orderUnits      = input.int(10000, "Order size in units (backtest AND webhook)", group=grpWebhook,
     tooltip="Used for both the Strategy Tester position size and the webhook alert, so the " +
             "backtest PnL matches what OANDA would actually trade. Margin is modeled at 50:1 " +
             "(OANDA US): a $100 account supports roughly 4,000 units max — use ~2,000 to be safe. " +
             "If you raise this above 10000, raise MAX_ORDER_UNITS in the server's .env to match.")
oandaInstrument = input.string("EUR_USD", "OANDA instrument (must match webhook payload)", group=grpWebhook)

grpDisplay = "Display"
showSmas      = input.bool(true, "Show SMAs", group=grpDisplay)
showSignals   = input.bool(true, "Show entry/exit markers", group=grpDisplay)
showLevels    = input.bool(true, "Show entry / stop / target lines", group=grpDisplay)
shadePosition = input.bool(true, "Shade background while in a position", group=grpDisplay)
showDebug     = input.bool(false, "Show entry debug labels (RSI / trend check)", group=grpDisplay,
     tooltip="Prints the RSI value and trend-filter state at every entry so you can verify each " +
             "marker obeys the rules. If an entry ever shows RSI at or above the entry level, " +
             "that is a bug — report it.")

// ---- Indicators ----
rsiValue = ta.rsi(close, rsiLength)
trendSma = ta.sma(close, trendSmaLen)
exitSma  = ta.sma(close, exitSmaLen)
atrValue = ta.atr(atrLength)
recentHigh = ta.highest(high, pullbackLookback)
recentLow  = ta.lowest(low, pullbackLookback)

// ---- Position sizing ----
// Cap the order to what the account can actually margin at 50:1 (must stay in sync
// with margin_long/margin_short above). Without this, an account too small for
// orderUnits silently takes zero trades while entry signals keep plotting.
maxAffordableUnits = math.max(0, math.floor(strategy.equity * 50.0 * 0.8 / close))
tradeUnits = math.min(orderUnits, maxAffordableUnits)

var table warnTable = table.new(position.top_right, 1, 1)
if barstate.islast
    if tradeUnits < orderUnits
        table.cell(warnTable, 0, 0,
             "⚠ Account can only margin ~" + str.tostring(maxAffordableUnits) +
             " units — orders capped to that (requested " + str.tostring(orderUnits) + ")",
             text_color=color.white, bgcolor=color.new(color.red, 15), text_size=size.small)

// ---- Position state ----
inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0
isFlat  = strategy.position_size == 0

// ---- Signals ----
// Every signal is gated on the current position so it fires exactly once per trade.
longTrendOk  = not useTrendFilter or close > trendSma
shortTrendOk = not useTrendFilter or close < trendSma
longDipOk    = minPullbackAtr == 0.0 or (recentHigh - close) >= minPullbackAtr * atrValue
shortDipOk   = minPullbackAtr == 0.0 or (close - recentLow) >= minPullbackAtr * atrValue

canTrade = tradeUnits > 0

longEntrySignal  = isFlat and canTrade and rsiValue < rsiEntryLevel and longTrendOk and longDipOk
shortEntrySignal = enableShorts and isFlat and canTrade and rsiValue > (100 - rsiEntryLevel) and shortTrendOk and shortDipOk

// Entry / stop / target levels, fixed at the moment of entry.
var float entryPrice = na
var float stopPrice  = na
var float tpPrice    = na
if longEntrySignal
    entryPrice := close
    stopPrice  := close - slAtrMult * atrValue
    tpPrice    := close + tpAtrMult * atrValue
if shortEntrySignal
    entryPrice := close
    stopPrice  := close + slAtrMult * atrValue
    tpPrice    := close - tpAtrMult * atrValue

// Exits are evaluated on bar close (same moment the webhook alert fires) so the
// tester matches live behavior. OANDA additionally holds the hard stop/target from
// the entry order, which protects the position between bar closes.
longStopHit    = useStopLoss and inLong and close <= stopPrice
longTpHit      = useTakeProfit and inLong and close >= tpPrice
longExitSignal = inLong and (close > exitSma or longStopHit or longTpHit)

shortStopHit    = useStopLoss and inShort and close >= stopPrice
shortTpHit      = useTakeProfit and inShort and close <= tpPrice
shortExitSignal = inShort and (close < exitSma or shortStopHit or shortTpHit)

// ---- Strategy Tester orders (Phase 1: pure backtest, no live orders) ----
if longEntrySignal
    strategy.entry("Long", strategy.long, qty=tradeUnits)
if longExitSignal
    strategy.close("Long")
if shortEntrySignal
    strategy.entry("Short", strategy.short, qty=tradeUnits)
if shortExitSignal
    strategy.close("Short")

// ---- Plots ----
plot(showSmas ? trendSma : na, "Trend SMA", color=color.orange, linewidth=2)
plot(showSmas ? exitSma : na, "Exit SMA", color=color.new(color.blue, 30))

showFrom = inLong or inShort or longEntrySignal or shortEntrySignal
plot(showLevels and showFrom ? entryPrice : na, "Entry price", color=color.gray,
     style=plot.style_linebr)
plot(showLevels and showFrom and useStopLoss ? stopPrice : na, "Stop loss", color=color.red,
     style=plot.style_linebr, linewidth=2)
plot(showLevels and showFrom and useTakeProfit ? tpPrice : na, "Take profit", color=color.teal,
     style=plot.style_linebr, linewidth=2)

plotshape(showSignals and longEntrySignal, "Long entry", style=shape.triangleup,
     location=location.belowbar, color=color.green, size=size.small)
plotshape(showSignals and longExitSignal, "Long exit", style=shape.xcross,
     location=location.abovebar, color=color.gray, size=size.tiny)
plotshape(showSignals and shortEntrySignal, "Short entry", style=shape.triangledown,
     location=location.abovebar, color=color.red, size=size.small)
plotshape(showSignals and shortExitSignal, "Short exit", style=shape.xcross,
     location=location.belowbar, color=color.gray, size=size.tiny)
bgcolor(shadePosition and inLong ? color.new(color.green, 92) :
     shadePosition and inShort ? color.new(color.red, 92) : na)

if showDebug and (longEntrySignal or shortEntrySignal)
    label.new(bar_index, low,
         text="RSI " + str.tostring(rsiValue, "#.#") +
             (close > trendSma ? "\nabove 200SMA" : "\nbelow 200SMA") +
             "\ndip " + str.tostring((recentHigh - close) / atrValue, "#.#") + " ATR",
         style=label.style_label_up, color=color.new(color.blue, 20),
         textcolor=color.white, size=size.small)

// ---- Alerts (Phase 2: wire these up to the webhook bridge once backtest looks good) ----
// Create a TradingView alert on this script with condition "Any alert() function call".
// Replace WEBHOOK_SECRET below with the value from your .env before creating the alert.
// Entry alerts include the stop/target prices so the server can attach real stop-loss
// and take-profit orders at OANDA — protection lives at the broker, not just on the chart.
slJson = useStopLoss ? ',"stop_loss":' + str.tostring(stopPrice, "#.#####") : ""
tpJson = useTakeProfit ? ',"take_profit":' + str.tostring(tpPrice, "#.#####") : ""

if longEntrySignal
    alert('{"secret":"WEBHOOK_SECRET","instrument":"' + oandaInstrument +
         '","action":"buy","units":' + str.tostring(tradeUnits) + slJson + tpJson + '}',
         alert.freq_once_per_bar_close)
if longExitSignal
    alert('{"secret":"WEBHOOK_SECRET","instrument":"' + oandaInstrument +
         '","action":"close_all","units":0}', alert.freq_once_per_bar_close)
if shortEntrySignal
    alert('{"secret":"WEBHOOK_SECRET","instrument":"' + oandaInstrument +
         '","action":"sell","units":' + str.tostring(tradeUnits) + slJson + tpJson + '}',
         alert.freq_once_per_bar_close)
if shortExitSignal
    alert('{"secret":"WEBHOOK_SECRET","instrument":"' + oandaInstrument +
         '","action":"close_all","units":0}', alert.freq_once_per_bar_close)
